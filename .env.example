# HTTP and browser integration
PORT=3001
CLIENT_ORIGIN=http://localhost:8000
SYSTEM_ADMIN_PORTAL_URL=http://localhost:5099

# Messaging and projection state
RABBITMQ_URL=amqp://auction:change_me_in_local_env@localhost:5672
RABBITMQ_EXCHANGE=auction.events
LIVE_FEED_RABBITMQ_QUEUE=live-feed.bid-events
LIVE_FEED_RABBITMQ_PREFETCH=10
LIVE_FEED_RABBITMQ_DLX=live-feed.dead-letter
LIVE_FEED_RABBITMQ_DLQ=live-feed.bid-events.dlq
REDIS_URL=redis://localhost:6379
LIVE_FEED_IDEMPOTENCY_TTL_SECONDS=86400

# Optional history persistence
LIVE_FEED_DATABASE_URL=
LIVE_FEED_DB_POOL_MAX=5
LIVE_FEED_DB_IDLE_TIMEOUT_MS=10000
LIVE_FEED_DB_CONNECTION_TIMEOUT_MS=2000

# Admin and service-to-service authentication. Supply real paths/secrets locally.
SYSTEM_ADMIN_TOKEN_PUBLIC_KEY_PATH=config/system-admin-public.pem
SYSTEM_ADMIN_TOKEN_PUBLIC_KEYS=
SYSTEM_ADMIN_TOKEN_ISSUER=dbap-system-admin
SYSTEM_ADMIN_TOKEN_AUDIENCE=live-feed-admin
SYSTEM_ADMIN_TOKEN_KID=system-admin-development-1
LIVE_FEED_ADMIN_SESSION_SECRET=
BIDDING_SERVICE_INTERNAL_URL=http://localhost:5000
LIVE_FEED_SERVICE_PRIVATE_KEY_PATH=config/live-feed-service-private.pem
LIVE_FEED_SERVICE_TOKEN_ISSUER=dbap-live-feed-service
LIVE_FEED_SERVICE_TOKEN_SUBJECT=live-feed-service
LIVE_FEED_SERVICE_TOKEN_AUDIENCE=dbap-bidding-service
LIVE_FEED_SERVICE_TOKEN_KEY_ID=live-feed-service-v1
LIVE_FEED_SERVICE_TOKEN_TTL_SECONDS=30
